---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer>
  <p>© {year} {site.name}</p>
  <ul>
    {
      site.socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  p {
    margin: 0;
  }
  ul {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
