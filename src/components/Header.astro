---
import { nav, site } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <nav>
    <a href="/" class="brand">{site.name}</a>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={
                current === item.href || (item.href !== '/' && current.startsWith(item.href))
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .brand {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    color: var(--muted);
    text-decoration: none;
  }
  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--accent);
  }
</style>
