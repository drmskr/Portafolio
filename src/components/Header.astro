---
import { nav, site } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="topbar">
  <a href="/" class="topbar__brand">{site.name}</a>
  <nav>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
