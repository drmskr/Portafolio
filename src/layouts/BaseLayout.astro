---
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Oculta la barra superior (la portada trae su propia navegación). */
  hideHeader?: boolean;
}

const { title, description = site.description, hideHeader = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Portafolio`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@700;800&family=Poppins:wght@400;500&family=Libre+Caslon+Text&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    {!hideHeader && <Header />}
    <slot />
    <Contact />
  </body>
</html>
