---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const skills = ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'Astro', 'Git'];
---

<BaseLayout title="Sobre mí">
  <section class="section">
    <div class="section__head">
      <h1 class="display-md">Sobre <span class="accent">mí</span></h1>
      <p class="caption">{site.basedIn}</p>
    </div>
    <div class="prose">
      <p>
        Escribe aquí una breve presentación: quién eres, qué te apasiona y qué tipo de proyectos
        te gusta construir.
      </p>

      <h2>Habilidades</h2>
      <div class="project__tags">
        {skills.map((skill) => <span class="tag">{skill}</span>)}
      </div>

      <h2>Experiencia</h2>
      <p class="caption">Agrega tu experiencia laboral, educación o certificaciones.</p>

      <h2>Redes</h2>
      <p>
        {
          site.socials.map((s, i) => (
            <>
              {i > 0 && ' · '}
              <a href={s.href} target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </>
          ))
        }
      </p>
    </div>
  </section>
</BaseLayout>
