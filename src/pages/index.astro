---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout hideHeader>
  <Hero />
  <ProjectGrid title="Proyectos" projects={featured}>
    <p style="margin-top: 32px"><a href="/projects" class="btn btn--solid">Ver todos</a></p>
  </ProjectGrid>
</BaseLayout>
