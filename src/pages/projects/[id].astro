---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, date, tags, repo, demo, image } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description}>
  <article class="section">
    <a href="/projects" class="back">← Volver a proyectos</a>
    <div class="section__head">
      <h1 class="display-md">{title}</h1>
      <p class="caption">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', timeZone: 'UTC' })}
        </time>
      </p>
    </div>

    {
      tags.length > 0 && (
        <div class="project__tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }

    {image && <img src={image} alt="" class="project__cover" />}

    <div class="prose">
      <Content />
    </div>

    {
      (repo || demo) && (
        <p class="project__links">
          {demo && (
            <a href={demo} class="btn btn--solid" target="_blank" rel="noopener noreferrer">
              Ver demo
            </a>
          )}
          {repo && (
            <a href={repo} class="btn btn--solid" target="_blank" rel="noopener noreferrer">
              Código
            </a>
          )}
        </p>
      )
    }
  </article>
</BaseLayout>
